DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_ml_vectordb
DB_USER=postgres
DB_PASSWORD=testing@123

# Choose the vector database: postgres or mongodb.
# VECTOR_STORE=postgres
VECTOR_STORE=mongodb
POSTGRES_TABLE=vector_embeddings

# Required only when VECTOR_STORE=mongodb.
MONGODB_URI=
MONGODB_DATABASE=ai_ml_vectordb
MONGODB_COLLECTION=vector_embeddings
MONGODB_INDEX_NAME=vector_index

# S3 document storage
# Use either AWS_S3_BUCKET with the bucket name or AWS_S3_BUCKET_URL with
# an s3:// or https:// bucket URL. Do not commit real credentials here.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# AWS_S3_BUCKET_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
AWS_S3_PREFIX=documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=



# Choose exactly one answer-generation provider: ollama or gemini.
# LLM_PROVIDER=ollama
LLM_PROVIDER=gemini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Required only when LLM_PROVIDER=gemini. Never

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
